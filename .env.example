# LiveClipper - configuração local
# Copie para .env e ajuste. Não versione o .env.

LIVECLIPPER_ENVIRONMENT=development
LIVECLIPPER_LOG_LEVEL=INFO
LIVECLIPPER_API_PREFIX=/api/v1

# Diretórios
LIVECLIPPER_DATA_DIR=./data
LIVECLIPPER_OUTPUT_DIR=./output
LIVECLIPPER_DATABASE_URL=sqlite:///./data/liveclipper.db

# Pasta onde o OBS grava. Também pode ser definida por fonte via API.
LIVECLIPPER_OBS_RECORDINGS_DIR=./data/obs

# OBS WebSocket (opcional na Fase 1; a captura lê os arquivos do OBS)
# Nunca preencha segredos neste exemplo. Use o .env local, que é ignorado pelo Git.
LIVECLIPPER_OBS_WEBSOCKET_URL=ws://127.0.0.1:4455
LIVECLIPPER_OBS_WEBSOCKET_PASSWORD=

# Captura
# Adaptador de origem do vídeo. Na Fase 1: obs_directory.
LIVECLIPPER_SOURCE_ADAPTER=obs_directory
LIVECLIPPER_RECORDING_EXTENSIONS=.mkv,.mp4,.mov,.flv,.ts
LIVECLIPPER_CAPTURE_POLL_INTERVAL_SECONDS=5
# Arquivo só é registrado após ficar este tempo sem alteração.
LIVECLIPPER_CAPTURE_SETTLE_SECONDS=20
LIVECLIPPER_CAPTURE_AUTO_START=true
